#!/bin/bash
# Installs a LaunchDaemon that runs a Jamf inventory update at boot.
# Improvements: strict mode, root check, cleanup trap, safer install, logging,
# and handling of existing LaunchDaemon.

set -euo pipefail

readonly LaunchDaemonName="com.github.runjamfproinventoryupdate"
readonly JAMF_BIN="/usr/local/jamf/bin/jamf"
readonly PLIST_DEST="/Library/LaunchDaemons/${LaunchDaemonName}.plist"
readonly LOG_PATH="/var/log/${LaunchDaemonName}.log"

ERROR=0

log() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Must be run as root
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  die "This script must be run as root (use sudo)."
fi

# Validate jamf binary exists and is executable
if [[ ! -x "$JAMF_BIN" ]]; then
  die "Jamf binary not found at $JAMF_BIN. Install Jamf or adjust JAMF_BIN."
fi

# Create temp directory and ensure cleanup on exit
temp_directory=$(mktemp -d) || die "Failed to create temp directory."
trap 'rm -rf "$temp_directory"' EXIT

plist_temp="$temp_directory/${LaunchDaemonName}.plist"

# Create the plist. Use StandardOutPath/StandardErrorPath to capture output.
cat > "$plist_temp" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LaunchDaemonName}</string>

  <!-- Using sh -c to allow check-then-run logic. For more complex logic, create a wrapper script and call it directly. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>"${JAMF_BIN} checkJSSConnection -retry 30 && ${JAMF_BIN} recon"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Capture stdout/stderr -->
  <key>StandardOutPath</key>
  <string>${LOG_PATH}</string>
  <key>StandardErrorPath</key>
  <string>${LOG_PATH}</string>
</dict>
</plist>
PLIST_EOF

# Use install to set owner & mode atomically; prepare for replacement if needed.
if /bin/ls "$PLIST_DEST" >/dev/null 2>&1; then
  log "Existing plist found at ${PLIST_DEST}; attempting to unload it first..."
  if /bin/launchctl print "system/${LaunchDaemonName}" >/dev/null 2>&1; then
    /bin/launchctl bootout system "$PLIST_DEST" >/dev/null 2>&1 || log "launchctl bootout failed (continuing)"
  else
    /bin/launchctl remove "${LaunchDaemonName}" >/dev/null 2>&1 || true
  fi
fi

# Install the new plist with proper owner/permissions
/usr/bin/install -o root -g wheel -m 0644 "$plist_temp" "$PLIST_DEST"

# Ensure log file exists and is writable by root
: > "$LOG_PATH" || die "Cannot create log file at $LOG_PATH"
/usr/sbin/chown root:wheel "$LOG_PATH"
/usr/bin/chmod 0640 "$LOG_PATH"

# Load the LaunchDaemon
log "Bootstrapping LaunchDaemon..."
if /bin/launchctl bootstrap system "$PLIST_DEST"; then
  log "LaunchDaemon bootstrapped."
else
  /bin/launchctl print "system/${LaunchDaemonName}" >/dev/null 2>&1 || log "launchctl print failed or daemon not present."
fi

# Verify the LaunchDaemon is loaded
if /bin/launchctl print "system/${LaunchDaemonName}" >/dev/null 2>&1; then
  log "${LaunchDaemonName} LaunchDaemon is loaded. Jamf inventory updates will run at boot. Logs: ${LOG_PATH}"
else
  die "${LaunchDaemonName} LaunchDaemon is not loaded after bootstrap."
fi

exit "$ERROR"
